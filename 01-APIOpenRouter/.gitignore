MANIFEST

# Virtual Environments
# (Prevents thousands of dependency files from committing)
.venv/
venv/
ENV/
env/
ENV/
env.bak/
venv.bak/

# Environment variables and secrets
# (Never commit API keys or production database passwords)
.env
.secret
*.pem

# Inline configuration & Lockfiles 
# (Uncomment lockfiles only if you intend to track them for app deployments)
# pipenv.lock
# poetry.lock
# uv.lock

